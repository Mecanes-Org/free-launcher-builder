<?xml version="1.0" encoding="utf-8"?>

<Window x:Class="FreeLauncherBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:local="clr-namespace:FreeLauncherBuilder" 
        mc:Ignorable="d" 
        Title="Free Launcher Builder" 
        MinWidth="800" 
        MaxWidth="800"
        MinHeight="720"
        WindowStartupLocation="CenterScreen" 
        Background="#101114"
        Icon="/Images/free.ico"
        >

    <Window.Resources>

        <!-- ============================== -->

        <!-- TEXTBOX -->

        <!-- ============================== -->

        <Style x:Key="InputStyle" TargetType="TextBox">

            <Setter Property="Height" Value="42" />

            <Setter Property="Background" Value="#181A1F" />

            <Setter Property="Foreground" Value="White" />

            <Setter Property="BorderBrush" Value="#30333A" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Padding" Value="12,0" />

            <Setter Property="FontSize" Value="14" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">

                            <ScrollViewer x:Name="PART_ContentHost" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused" Value="True">

                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#FF4D4D" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ============================== -->

        <!-- BROWSE BUTTON -->

        <!-- ============================== -->

        <Style x:Key="BrowseButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="45" />

            <Setter Property="Height" Value="42" />

            <Setter Property="Margin" Value="8,0,0,0" />

            <Setter Property="Background" Value="#252830" />

            <Setter Property="Foreground" Value="White" />

            <Setter Property="BorderBrush" Value="#343740" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="FontSize" Value="18" />

            <Setter Property="FontWeight" Value="Bold" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="#353944" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF4040" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ============================== -->

        <!-- GENERATE BUTTON -->

        <!-- ============================== -->

        <Style x:Key="GenerateButtonStyle" TargetType="Button">

            <Setter Property="Height" Value="55" />

            <Setter Property="MinWidth" Value="260" />

            <Setter Property="Background" Value="#E53935" />

            <Setter Property="Foreground" Value="White" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="FontSize" Value="17" />

            <Setter Property="FontWeight" Value="Bold" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="GenerateBorder" Background="{TemplateBinding Background}" CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="GenerateBorder" Property="Background" Value="#FF4A45" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="GenerateBorder" Property="Background" Value="#B71C1C" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ============================== -->

        <!-- LABEL -->

        <!-- ============================== -->

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">

            <Setter Property="Foreground" Value="#AEB1B8" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="Margin" Value="0,0,0,6" />

        </Style>

        <!-- ===================================================== -->

        <!-- COMBOBOX ITEM -->

        <!-- ===================================================== -->

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">

            <Setter Property="Foreground" Value="White" />

            <Setter Property="Background" Value="#181A1F" />

            <Setter Property="Padding" Value="12,8" />

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4">

                            <ContentPresenter Margin="{TemplateBinding Padding}" TextElement.FontFamily="{Binding}"
                                              VerticalAlignment="Center" />
                            
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Mouse hover -->

                            <Trigger Property="IsHighlighted" Value="True">

                                <Setter TargetName="ItemBorder" Property="Background" Value="#292C34" />

                            </Trigger>

                            <!-- Selected item -->

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="ItemBorder" Property="Background" Value="#E53935" />

                                <Setter Property="Foreground" Value="White" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!-- ===================================================== -->

        <!-- COMBOBOX -->

        <!-- ===================================================== -->

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">

            <Setter Property="Height" Value="42" />

            <Setter Property="Background" Value="#181A1F" />

            <Setter Property="Foreground" Value="White" />

            <Setter Property="BorderBrush" Value="#30333A" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Padding" Value="12,0" />

            <Setter Property="FontSize" Value="14" />

            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <!-- Visible ComboBox -->

                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border x:Name="ComboBorder" Background="#181A1F" BorderBrush="#30333A" BorderThickness="1" CornerRadius="6">

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="40" />

                                                </Grid.ColumnDefinitions>

                                                <!-- Selected value -->

                                                <ContentPresenter Grid.Column="0" Margin="12,0,5,0" HorizontalAlignment="Left" TextElement.Foreground="White" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />

                                                <!-- Arrow -->

                                                <TextBlock Grid.Column="1" Text="?" Foreground="#AEB1B8" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            </Grid>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">

                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#555A66" />

                                            </Trigger>

                                            <Trigger Property="IsChecked" Value="True">

                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#E53935" />

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                            <!-- Dropdown -->

                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade">

                                <Border Width="{Binding ActualWidth, ElementName=ToggleButton}" Margin="0,4,0,0" Background="#181A1F" BorderBrush="#30333A" BorderThickness="1" CornerRadius="6">

                                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">

                                        <StackPanel IsItemsHost="True" />

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- SCROLLBAR THUMB -->
        <Style x:Key="DarkScrollThumbStyle" TargetType="Thumb">
            
            <Setter Property="Background" Value="#3A3D45"/>
            
            <Setter Property="Template">
                
                <Setter.Value>
                    
                    <ControlTemplate TargetType="Thumb">
                        
                        <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" CornerRadius="5"/>
                        
                        <ControlTemplate.Triggers>
                            
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#E53935"/>
                            </Trigger>
                            
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF4A45"/>
                            </Trigger>
                        
                        </ControlTemplate.Triggers>
                    
                    </ControlTemplate>
                
                </Setter.Value>
                
            </Setter>
        
        </Style>

        <!-- SCROLLBAR -->
        <Style TargetType="ScrollBar">
            
            <Setter Property="Width" Value="10"/>
            
            <Setter Property="Background" Value="#15171B"/>
            
            <Setter Property="Template">
                
                <Setter.Value>
                    
                    <ControlTemplate TargetType="ScrollBar">
                        
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                               
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollThumbStyle}"/>
                                </Track.Thumb>
                                
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            
                            </Track>
                        
                        </Border>
                    
                    </ControlTemplate>
                
                </Setter.Value>
            
            </Setter>
        
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="75" />

            <RowDefinition Height="*" />

            <RowDefinition Height="90" />

        </Grid.RowDefinitions>

        <!-- ===================================================== -->

        <!-- HEADER -->

        <!-- ===================================================== -->

        <Border Grid.Row="0" Background="#15171B" BorderBrush="#25272D" BorderThickness="0,0,0,1">

            <Grid Margin="30,0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Launcher Builder" Foreground="White" FontSize="25" FontWeight="Bold" />

                    <TextBlock Text="Configure and generate your game launcher" Foreground="#777B83" FontSize="13" Margin="0,4,0,0" />

                </StackPanel>

            </Grid>

        </Border>

        <!-- ===================================================== -->

        <!-- CONTENT -->

        <!-- ===================================================== -->

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="40,30,40,30">

                <!-- ================================================= -->

                <!-- PROJECT -->

                <!-- ================================================= -->

                <TextBlock Text="PROJECT" Foreground="#FF4B47" FontWeight="Bold" FontSize="13" Margin="0,0,0,15" />

                <Border Background="#15171B" CornerRadius="10" Padding="25" BorderBrush="#26282E" BorderThickness="1">

                    <StackPanel>

                        <!-- Launcher name -->

                        <TextBlock Text="Launcher name" Style="{StaticResource FieldLabelStyle}" />

                        <TextBox x:Name="LauncherNameTextBox" Style="{StaticResource InputStyle}" Text="My Game - Launcher" Margin="0,0,0,18" />

                        <!-- Game name -->

                        <TextBlock Text="Game name" Style="{StaticResource FieldLabelStyle}" />

                        <TextBox x:Name="GameNameTextBox" Style="{StaticResource InputStyle}" Text="My Game" Margin="0,0,0,18" />

                        <!-- Executable -->

                        <TextBlock Text="Game executable" Style="{StaticResource FieldLabelStyle}" />

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="GameExecutableTextBox" Grid.Column="0" Style="{StaticResource InputStyle}" Text="" />

                            <Button x:Name="BrowseExecutableButton" Grid.Column="1" Content="..." Style="{StaticResource BrowseButtonStyle}" Click="BrowseExecutableButton_Click" />

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- ================================================= -->

                <!-- APPEARANCE -->

                <!-- ================================================= -->

                <TextBlock Text="APPEARANCE" Foreground="#FF4B47" FontWeight="Bold" FontSize="13" Margin="0,30,0,15" />

                <Border Background="#15171B" CornerRadius="10" Padding="25" BorderBrush="#26282E" BorderThickness="1">

                    <StackPanel>

                        <!-- Background Image -->

                        <TextBlock Text="Background image" Style="{StaticResource FieldLabelStyle}" />

                        <Grid Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="BackgroundPathTextBox" Style="{StaticResource InputStyle}" Text="" />

                            <Button x:Name="BrowseBackgroundButton" Grid.Column="1" Content="..." Click="BrowseBackgroundButton_Click" Style="{StaticResource BrowseButtonStyle}" />

                        </Grid>

                        <!-- Logo -->

                        <TextBlock Text="Logo" Style="{StaticResource FieldLabelStyle}" />

                        <Grid Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="LogoPathTextBox" Style="{StaticResource InputStyle}" Text="" />

                            <Button x:Name="BrowseLogoButton" Grid.Column="1" Content="..." Click="BrowseLogoButton_Click" Style="{StaticResource BrowseButtonStyle}" />

                        </Grid>

                        <!-- Icon -->

                        <TextBlock Text="Launcher icon" Style="{StaticResource FieldLabelStyle}" />

                        <Grid Margin="0,0,0,18">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="IconPathTextBox" Style="{StaticResource InputStyle}" Text="" />

                            <Button x:Name="BrowseIconButton" Grid.Column="1" Content="..." Click="BrowseIconButton_Click" Style="{StaticResource BrowseButtonStyle}" />

                        </Grid>

                        <!-- Font -->

                        <TextBlock Text="Game title font" Style="{StaticResource FieldLabelStyle}" />

                        <ComboBox x:Name="GameFontComboBox" Style="{StaticResource DarkComboBoxStyle}" Height="42" Cursor="Hand"
                                  Background="#181A1F" Foreground="White" BorderBrush="#30333A" Padding="10,0" SelectedIndex="0">

                            <ComboBoxItem Content="Inter" />

                            <ComboBoxItem Content="Arial" />

                            <ComboBoxItem Content="Segoe UI" />

                            <ComboBoxItem Content="ROG Fonts" />

                        </ComboBox>

                    </StackPanel>

                </Border>

                <!-- ================================================= -->

                <!-- PLAY BUTTON -->

                <!-- ================================================= -->

                <TextBlock Text="PLAY BUTTON" Foreground="#FF4B47" FontWeight="Bold" FontSize="13" Margin="0,30,0,15" />

                <Border Background="#15171B" CornerRadius="10" Padding="25" BorderBrush="#26282E" BorderThickness="1">

                    <StackPanel>

                        <!-- Text -->

                        <TextBlock Text="Button text" Style="{StaticResource FieldLabelStyle}" />

                        <TextBox x:Name="PlayButtonTextTextBox" Style="{StaticResource InputStyle}" Text="PLAY" Margin="0,0,0,20" />

                        <!-- Colors -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="20" />

                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>

                            <!-- LEFT -->

                            <StackPanel Grid.Column="0">

                                <!-- Background color -->
                                <TextBlock Text="Background color" Style="{StaticResource FieldLabelStyle}" />

                                <Grid Margin="0,0,0,18">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="PlayButtonBackgroundTextBox" Style="{StaticResource InputStyle}"
                                         Text="#99000000"
                                         IsReadOnly="True"/>

                                    <Button Grid.Column="1" Content="🎨" Style="{StaticResource BrowseButtonStyle}"
                                        Click="PlayButtonBackgroundColorButton_Click"/> 

                                </Grid>


                                <!-- Text color -->
                                <TextBlock Text="Text color" Style="{StaticResource FieldLabelStyle}" />

                                <Grid Margin="0,0,0,18">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="PlayButtonForegroundTextBox" Style="{StaticResource InputStyle}"
                                         Text="#FFFF0000"
                                         IsReadOnly="True"/>        

                                    <Button Grid.Column="1" Content="🎨" Style="{StaticResource BrowseButtonStyle}"
                                        Click="PlayButtonForegroundColorButton_Click"/> 

                                </Grid>


                                <!-- Border color -->
                                <TextBlock Text="Border color" Style="{StaticResource FieldLabelStyle}" />

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="PlayButtonBorderTextBox" Style="{StaticResource InputStyle}"
                                         Text="#FFFF0000"
                                         IsReadOnly="True"/>

                                    <Button Grid.Column="1" Content="🎨"
                                        Style="{StaticResource BrowseButtonStyle}"
                                        Click="PlayButtonBorderColorButton_Click"/>

                                </Grid>

                            </StackPanel>

                            <!-- RIGHT -->

                            <StackPanel Grid.Column="2">
                                
                                <TextBlock Text="Hover background" Style="{StaticResource FieldLabelStyle}" />
                                
                                <Grid Margin="0,0,0,18">
                                    
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="PlayButtonHoverBackgroundTextBox" Style="{StaticResource InputStyle}" Text="#CCAA0000" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="🎨" Style="{StaticResource BrowseButtonStyle}" Click="PlayButtonHoverBackgroundColorButton_Click"/>
                                
                                </Grid>

                                <TextBlock Text="Hover text" Style="{StaticResource FieldLabelStyle}" />
                                
                                <Grid Margin="0,0,0,18">
                                    
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="PlayButtonHoverForegroundTextBox" Style="{StaticResource InputStyle}" Text="#FFFFFFFF" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="🎨" Style="{StaticResource BrowseButtonStyle}" Click="PlayButtonHoverForegroundColorButton_Click"/>
                                
                                </Grid>

                                <TextBlock Text="Pressed background" Style="{StaticResource FieldLabelStyle}" />
                                
                                <Grid>
                                    
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="PlayButtonPressedBackgroundTextBox" Style="{StaticResource InputStyle}" Text="#FFFF0000" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="🎨" Style="{StaticResource BrowseButtonStyle}" Click="PlayButtonPressedBackgroundColorButton_Click"/>
                                
                                </Grid>
                                
                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- ===================================================== -->

        <!-- BOTTOM GENERATE -->

        <!-- ===================================================== -->

        <Border Grid.Row="2" Background="#15171B" BorderBrush="#25272D" BorderThickness="0,1,0,0">

            <Button x:Name="GenerateLauncherButton" Content="GENERATE LAUNCHER" Style="{StaticResource GenerateButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0" Click="GenerateLauncherButton_Click" />

        </Border>

    </Grid>

</Window>